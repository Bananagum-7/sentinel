# Upstream provider (free key: https://console.groq.com)
GROQ_API_KEY=

# Path to the policy file that maps gateway API keys to apps and their rules
SENTINEL_POLICY_FILE=config/policies.yaml

# Optional: send OpenTelemetry traces to Langfuse (or any OTLP/HTTP endpoint)
# Langfuse: endpoint https://cloud.langfuse.com/api/public/otel, auth = base64("pk:sk")
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
